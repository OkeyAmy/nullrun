{
  "name": "nullrun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NULLRUN \u2014 a turn-based stealth roguelite designed to be played by a human and an AI agent together, over WebMCP.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke": "node tools/smoke.mjs",
    "assets": "tools/build-atlas.sh",
    "demo": "node tools/agent-demo.mjs",
    "evals:build": "node tools/build-evals.mjs",
    "evals": "node tools/run-evals.mjs",
    "evals:cli": "webmcp-evals smoke -u http://localhost:5183/ -e evals.json",
    "build:pages": "tsc --noEmit && GITHUB_PAGES=1 vite build"
  },
  "dependencies": {
    "@mcp-b/webmcp-polyfill": "^5.1.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
